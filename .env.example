# Pharatropic Wiki (PTC Wiki) Docker / TrueNAS SCALE Environment Configuration

# Host port mapping (Default 30085 for TrueNAS SCALE / Homelab friendliness)
PORT_HOST=30085

# Database Driver: 'postgres' or 'sqlite'
DB_DRIVER=postgres

# PostgreSQL Connection Credentials
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wikipassword
POSTGRES_DB=pharatropic_wiki

# Optional Master API Key (Leave empty to use user-generated API keys)
API_KEY=

# JWT signing secret — required. Generate a long random value, e.g.:
#   openssl rand -hex 32
# If left unset, the server generates a random one at startup and all
# sessions are invalidated on every restart.
JWT_SECRET=
